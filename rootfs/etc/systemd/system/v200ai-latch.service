[Unit]
Description=Clear the one-shot boot guard on successful boot
# guard.bin 由 U-Boot 的 bootcmd 在 p1 上创建；启动成功才由这里删除。
# 必须等 p1 挂上，否则 rm 打在空目录上，guard.bin 留在盘上，下次上电就进 UMS。
RequiresMountsFor=/boot/firmware
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c "rm -f /boot/firmware/guard.bin; sync"
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
