[Unit]
Description=V200-AI tether/AP supervisor (keep AP up, connect iPhone when it appears)
# AP 由 v200ai-ap.service 常驻；这里只做守护：
#   · hostapd 掉线或固件无响应时重拉 AP（5 分钟最多一次）
#   · iPhone 蓝牙/热点可用时才连 PAN，连上后断开也会自动重连
After=v200ai-ap.service v200ai-bt-late.service systemd-networkd.service bluetooth.service
Wants=v200ai-bt-late.service

[Service]
Type=simple
ExecStart=/usr/local/bin/bt-tether-agent.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
