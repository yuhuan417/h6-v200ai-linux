[Unit]
Description=Grow the root filesystem into p2 on first boot
# 启动事务完成后再扩容：慢或失败都不影响 ssh / USB NCM / AP 起来。
# p2 已经在分区表里覆盖到盘尾（scripts/build-mbr.py），这里通常只做 resize2fs；
# 分区小于盘尾时脚本才先跑 growpart。
ConditionPathExists=!/var/lib/v200ai-growroot.done
After=multi-user.target
RequiresMountsFor=/var/lib

[Service]
Type=oneshot
ExecStart=/usr/local/bin/v200ai-growroot.sh
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
