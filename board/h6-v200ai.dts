						regulator-ramp-delay = <0x9c4>;
						regulator-name = "vdd-cpu";
						phandle = <0x04>;
					};

					dcdcc {
						regulator-enable-ramp-delay = <0x7d00>;
						regulator-min-microvolt = <0xc5c10>;
						regulator-max-microvolt = <0x107ac0>;
