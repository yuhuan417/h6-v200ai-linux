	};

	aliases {
		serial0 = "/soc/serial@5000000";
		serial1 = "/soc/serial@5000400";
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "console=tty0 loglevel=7 panic=10";
		linux,initrd-start = <0x50000000>;
		linux,initrd-end = <0x5052fdc4>;
	};

	connector {
		compatible = "hdmi-connector";
		ddc-en-gpios = <0x17 0x07 0x02 0x00>;
		type = "a";

		port {

			endpoint {
				remote-endpoint = <0x40>;
				phandle = <0x2b>;
			};
		};
	};

	ext_osc32k_clk {
		#clock-cells = <0x00>;
		compatible = "fixed-clock";
		clock-frequency = <0x8000>;
		clock-output-names = "ext_osc32k";
		phandle = <0x33>;
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "v200ai:red:power";
			gpios = <0x1b 0x00 0x04 0x00>;
			default-state = "on";
		};

		led-1 {
			label = "v200ai:blue:status";
			gpios = <0x1b 0x00 0x07 0x00>;
		};
	};

	vcc5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc-5v";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-always-on;
		phandle = <0x26>;
	};

	vcc33-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vcc33-wifi";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-always-on;
		vin-supply = <0x26>;
		phandle = <0x19>;
	};

	vcc-wifi-io {
		compatible = "regulator-fixed";
		regulator-name = "vcc-wifi-io";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-always-on;
		vin-supply = <0x19>;
		phandle = <0x15>;
	};

	wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <0x11 0x01>;
		clock-names = "ext_clock";
		reset-gpios = <0x1b 0x01 0x03 0x01>;
		post-power-on-delay-ms = <0xc8>;
		phandle = <0x1a>;
	};
};
